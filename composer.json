{
    "require": {
        "php": ">=8.5",
        "aura/router":       "@stable",
        "google/apiclient":  "@stable",
        "guzzlehttp/guzzle": "@stable",
        "graylog2/gelf-php": "@stable",
        "twig/twig":         "@stable"
    },
    "scripts": {
        "pre-autoload-dump": "Google\\Task\\Composer::cleanup"
    },
    "extra": {
        "google/apiclient-services": ["Calendar"]
    },
    "require-dev": {
        "phpstan/phpstan": "@stable"
    },
    "autoload": {
        "psr-4": {
            "Web\\":    "src/Web",
            "Domain\\": "src/Domain"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Test\\": "src/Test"
        }
    }
}
